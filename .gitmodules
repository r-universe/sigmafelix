	path = gopher
	url = https://github.com/sigmafelix/gopher
[submodule "stcvlite"]
	path = stcvlite
	url = https://github.com/sigmafelix/stcvlite
[submodule "tidycensuskr"]
	path = tidycensuskr
	url = https://github.com/sigmafelix/tidycensuskr
[submodule "tidycensuskr.sf"]
	path = tidycensuskr.sf
	url = https://github.com/sigmafelix/tidycensuskr.sf
